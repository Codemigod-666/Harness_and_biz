# devkit project config: shell-sourced KEY="value" lines, committed. `devkit init` writes .devkit/config.env
# from the commands it detects; this file documents every key.

# Fast checks (lint, types). Unset: `devkit check` says "not configured" and exits 0.
# DEVKIT_CHECK="npm run lint"

# Tests. Unset: same as above.
# DEVKIT_TEST="npm test"

# Everything that must be green before a branch lands. Required by `devkit gate` (exit 2 if unset).
# A project with a justfile or Makefile points this at it: DEVKIT_GATE="just gate"
# DEVKIT_GATE="npm run lint && npm test"

# End-to-end tests. They run on the worker's own port, $FLEET_PORT. Unset: same as DEVKIT_CHECK.
# DEVKIT_E2E="npm run e2e"

# Fleet test ports are base+1..base+9, one per worker.
# DEVKIT_PORT_BASE="4790"

# The branch workers rebase on and the supervisor lands on.
# DEVKIT_MAIN="main"
