#!/usr/bin/env python3
"""new-brief <ID> <worker> [model]: write .claude/fleet/briefs/<ID>-<worker>.md from the backlog item and
docs/fleet/templates/brief.md, copying Goal and Done when verbatim. Prints the path. Never overwrites."""
import datetime
import pathlib
import re
import subprocess
import sys


def repo_root() -> pathlib.Path:
    common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            capture_output=True, text=True, check=True).stdout.strip()
    return pathlib.Path(common).parent


def section(body: str, name: str) -> str:
    """Text after **<name>:** up to the next **Heading:** line, stripped."""
    match = re.search(rf"\*\*{name}:\*\*(.*?)(?=\n\*\*[A-Z][^*]*:\*\*|\Z)", body, re.S)
    return match.group(1).strip() if match else f"<missing **{name}:** in the backlog item>"


def main() -> None:
    if len(sys.argv) < 3:
        sys.exit("usage: new-brief <ID> <worker> [model]")
    item_id, worker = sys.argv[1], sys.argv[2]
    model = sys.argv[3] if len(sys.argv) > 3 else "sonnet"
    root = repo_root()
    items = sorted((root / "docs" / "backlog").glob(f"{item_id}-*.md"))
    if not items:
        sys.exit(f"new-brief: no backlog item {item_id}")
    item = items[0]
    text = item.read_text(encoding="utf-8")
    title = re.search(r'^title:\s*"?(.*?)"?\s*$', text, re.M)
    body = text.split("---", 2)[-1]
    out = root / ".claude" / "fleet" / "briefs" / f"{item_id}-{worker}.md"
    if out.exists():
        sys.exit(f"new-brief: {out} exists; edit it instead")
    template = (root / "docs" / "fleet" / "templates" / "brief.md").read_text(encoding="utf-8")
    done = "\n".join(line for line in section(body, "Done when").splitlines() if line.strip())
    brief = (template
             .replace("<ID> — <title>", f"{item_id} — {title.group(1) if title else item.stem}")
             .replace("<name>", worker, 1)
             .replace("<sonnet|opus>", model)
             .replace("<date>", datetime.date.today().isoformat(), 1)
             .replace("docs/backlog/<ID>-<slug>.md", str(item.relative_to(root)))
             .replace("<copied from the backlog item>", section(body, "Goal"))
             .replace("- [ ] <copied from the backlog item; each one checkable>", done)
             .replace("<ID>-<name>", f"{item_id}-{worker}"))
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(brief, encoding="utf-8")
    print(out)


if __name__ == "__main__":
    main()
