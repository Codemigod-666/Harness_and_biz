#!/usr/bin/env python3
"""check <handover.md>: fails if a required section is missing or still a template placeholder, or if the text
looks like it contains a secret. Prints each problem; exit 1 on any."""
import re
import sys

REQUIRED = ["## Goal", "## Next steps", "## In progress", "## Uncommitted", "## Decisions made", "## Gotchas"]
SECRETS = [r"sk-[A-Za-z0-9_-]{20,}", r"AKIA[0-9A-Z]{16}", r"-----BEGIN [A-Z ]*PRIVATE KEY-----",
           r"(?i)(password|passwd|secret|token|api[_-]?key)\s*[:=]\s*\S{6,}", r"ghp_[A-Za-z0-9]{30,}",
           r"xox[baprs]-[A-Za-z0-9-]{10,}"]


def main() -> None:
    path = sys.argv[1]
    text = open(path, encoding="utf-8").read()
    problems = [f"missing section {name}" for name in REQUIRED if name not in text]
    supervisor = "Role: supervisor" in text
    if not supervisor and "## Done" not in text:
        problems.append("missing section ## Done")
    leftovers = sorted(set(re.findall(r"<(?:one|concrete|sha|date|what|name|model|path|N)[^>]*>", text)))
    problems += [f"template placeholder left: {item}" for item in leftovers]
    if not re.search(r"after [0-9a-f]{7,}", text):
        problems.append("header must say 'after <sha>' (the commit the handover describes)")
    for pattern in SECRETS:
        if re.search(pattern, text):
            problems.append(f"possible secret matching /{pattern}/: remove it, reference it by name")
    for problem in problems:
        print(f"handover: {problem}")
    sys.exit(1 if problems else 0)


if __name__ == "__main__":
    main()
