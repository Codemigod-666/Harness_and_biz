# Copy to .env (gitignored). Every key the code reads is listed here with a comment.
# Prefix project keys with __PREFIX___.

# Runtime
__PREFIX___ROOT=.                  # repo root; data paths derive from it
__PREFIX___HTTP_ADDR=127.0.0.1:__P__20

# LLM (only for resolving what rules can't)
__PREFIX___LLM_PROVIDER=scripted    # scripted (offline, tests/demo) | anthropic | openai
ANTHROPIC_API_KEY=

# External APIs (recorded into data/derived/, replayed by the mock on __P__14)
# EXAMPLE_CLIENT_ID=
# EXAMPLE_CLIENT_SECRET=
